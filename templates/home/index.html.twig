{% extends 'base.html.twig' %}

{% block body %}
  <div class="container mx-auto max-w-4xl px-4 py-8 space-y-8">
    <div class="text-center space-y-4">
      <h1 class="text-4xl font-bold">
        Sébastien Glorian
      </h1>
      <p class="text-xl text-muted-foreground">
        Analyste développeur
      </p>

      <div class="flex flex-wrap justify-center gap-4 text-sm text-muted-foreground">
        <div class="flex items-center gap-1">
          <i class="fa-solid fa-map-pin h-4 w-4"></i>
          La Copechagnière, 85260, France
        </div>
      </div>
    </div>
    <div data-orientation="horizontal" role="none" data-slot="separator-root" class="bg-border shrink-0 data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full data-[orientation=vertical]:w-px"></div>
    <div data-slot="card" class="bg-card text-card-foreground flex flex-col gap-6 rounded-xl border">
