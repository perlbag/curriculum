<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Sébastien Glorian{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}Développeur back-end senior PHP/Symfony depuis plus de vingt ans — des solutions faites pour durer. Parcours, compétences et façon de travailler.{% endblock %}">
    <meta property="og:title" content="Sébastien Glorian — Développeur back-end senior">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:type" content="profile">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta property="og:locale" content="fr_FR">
    <meta name="twitter:card" content="summary">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%234338ca'/%3E%3Ctext x='16' y='21.5' font-family='ui-sans-serif,sans-serif' font-size='14' font-weight='700' fill='%23fff' text-anchor='middle'%3ESG%3C/text%3E%3C/svg%3E">
    <script>
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) { document.documentElement.classList.add('dark'); }
      window.addEventListener('beforeprint', function () { document.documentElement.classList.remove('dark'); });
      window.addEventListener('afterprint', function () { if (window.matchMedia('(prefers-color-scheme: dark)').matches) { document.documentElement.classList.add('dark'); } });
    </script>
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
  </head>
  <body>
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="container mx-auto flex h-16 items-center justify-between px-4">
        {% set route = app.request.attributes.get('_route') %}
        <div class="flex items-center space-x-2">
          {% if route != 'app_home' %}
          <a href="{{ url('app_home') }}" class="text-lg font-medium">Sébastien <strong>Glorian</strong></a>
          {% endif %}
        </div>
        <div class="flex items-center space-x-4">
        {% set baseClass = "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive" %}
        {% set activeClass = 'bg-primary text-primary-foreground hover:bg-primary/90' %}
        {% set ghostClass = 'hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50' %}
        {% set sizeClass = 'h-9 px-4 py-2 has-[>svg]:px-3' %}
          <a href="{{ url('app_home') }}" class="{{ baseClass }} {{ route == 'app_home' ? activeClass : ghostClass }} {{ sizeClass }}">Accueil</a>
          <a href="{{ url('app_contact') }}" class="{{ baseClass }} {{ route == 'app_contact' ? activeClass : ghostClass }} {{ sizeClass }}">Contact</a>
        </div>
      </div>
    </header>
    
    
    <main>
      {% for message in app.flashes('success') %}
      <div class="container mx-auto max-w-4xl px-4 pt-6 print:hidden">
        <div role="status" class="rounded-xl border border-transparent bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 px-4 py-3 text-sm">
          {{ message }}
        </div>
      </div>
      {% endfor %}
      {% block body %}{% endblock %}
    </main>
    <footer class="border-t">
      <div class="container mx-auto max-w-4xl px-4 py-6 space-y-2 text-sm text-muted-foreground">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2 print:hidden">
          <span>Sébastien Glorian — Développeur back-end senior</span>
          <a href="{{ url('app_contact') }}" class="underline underline-offset-4 hover:text-foreground">Me contacter</a>
        </div>
        <p class="text-xs text-center sm:text-left">
          Code source de ce site disponible sur <a href="https://github.com/perlbag/curriculum" class="underline underline-offset-4 hover:text-foreground">github.com/perlbag/curriculum</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
